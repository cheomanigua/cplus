#include <SFML/Graphics.hpp>

#include <algorithm>
#include <cmath>
#include <cstdlib>
#include <ctime>
#include <limits>
#include <optional>
#include <queue>
#include <random>
#include <string>
#include <vector>

// ============================================================
// Configuration
// ============================================================

constexpr int MAP_W = 60;
constexpr int MAP_H = 40;
constexpr int TILE_SIZE = 20;

constexpr int WINDOW_W = MAP_W * TILE_SIZE;
constexpr int WINDOW_H = MAP_H * TILE_SIZE;

constexpr float PLAYER_SPEED = 150.0f;
constexpr float ENEMY_SPEED = 65.0f;

constexpr float PLAYER_RADIUS = 7.0f;
constexpr float ENEMY_RADIUS = 6.0f;

constexpr int PLAYER_MAX_HP = 100;
constexpr int ENEMY_DAMAGE = 10;

constexpr float ATTACK_RANGE = 16.0f;
constexpr float ATTACK_COOLDOWN = 0.8f;
constexpr float PATH_RECALC_TIME = 0.25f;

// ============================================================
// Random Number Generator
// ============================================================

static std::mt19937 rng(
    static_cast<unsigned int>(
        std::chrono::high_resolution_clock::now()
            .time_since_epoch()
            .count()
    )
);

int RandomInt(int min, int max)
{
    std::uniform_int_distribution<int> dist(min, max);
    return dist(rng);
}

// ============================================================
// Tiles
// ============================================================

enum class Tile
{
    Wall,
    Floor,
    Courtyard,
    Garden,
    Cellar,
    Door,
    Stair
};

bool IsWalkable(Tile tile)
{
    return tile == Tile::Floor ||
           tile == Tile::Courtyard ||
           tile == Tile::Garden ||
           tile == Tile::Cellar ||
           tile == Tile::Door ||
           tile == Tile::Stair;
}

// ============================================================
// Room Types
// ============================================================

enum class RoomType
{
    Cloister,
    Church,
    ChapterHouse,
    Refectory,
    Sacristy,
    Dormitory,
    Calefactorium,
    Kitchen,
    Pantry,
    Cellar,
    Scriptorium,
    Library,
    Infirmary,
    Crypt,
    Cemetery,
    Gatehouse,
    Storage,
    Workshop,
    Garden
};

std::string RoomTypeName(RoomType type)
{
    switch (type)
    {
        case RoomType::Cloister:       return "CLOISTER";
        case RoomType::Church:         return "CHURCH";
        case RoomType::ChapterHouse:   return "CHAPTER HOUSE";
        case RoomType::Refectory:      return "REFECTORY";
        case RoomType::Sacristy:       return "SACRISTY";
        case RoomType::Dormitory:      return "DORMITORY";
        case RoomType::Calefactorium:  return "CALEFACTORIUM";
        case RoomType::Kitchen:        return "KITCHEN";
        case RoomType::Pantry:         return "PANTRY";
        case RoomType::Cellar:         return "CELLAR";
        case RoomType::Scriptorium:    return "SCRIPTORIUM";
        case RoomType::Library:        return "LIBRARY";
        case RoomType::Infirmary:      return "INFIRMARY";
        case RoomType::Crypt:          return "CRYPT";
        case RoomType::Cemetery:       return "CEMETERY";
        case RoomType::Gatehouse:      return "GATEHOUSE";
        case RoomType::Storage:        return "STORAGE";
        case RoomType::Workshop:       return "WORKSHOP";
        case RoomType::Garden:         return "GARDEN";
    }
    return "ROOM";
}

// ============================================================
// Room
// ============================================================

struct Room
{
    RoomType type;
    int x;
    int y;
    int width;
    int height;

    int CenterX() const { return x + width / 2; }
    int CenterY() const { return y + height / 2; }

    bool Contains(int px, int py) const
    {
        return px >= x && py >= y && px < x + width && py < y + height;
    }
};

// ============================================================
// Abbey Generator
// ============================================================

class Abbey
{
public:
    std::vector<std::vector<Tile>> tiles;
    std::vector<Room> rooms;

    int entranceRoom = -1;
    int libraryRoom = -1;

    Abbey()
    {
        Generate();
    }

    void Generate()
    {
        tiles.assign(MAP_H, std::vector<Tile>(MAP_W, Tile::Wall));
        rooms.clear();
        entranceRoom = -1;
        libraryRoom = -1;

        GenerateAbbeyLayout();
        ConnectRooms();
        AddArchitecture();
        AddEntrance();
        AddCellarStairs();
        RestoreOuterWalls();
    }

    bool Overlaps(const Room& a, const Room& b, int padding = 1) const
    {
        return !(
            a.x + a.width + padding <= b.x ||
            b.x + b.width + padding <= a.x ||
            a.y + a.height + padding <= b.y ||
            b.y + b.height + padding <= a.y
        );
    }

    void GenerateAbbeyLayout()
    {
        // 1. Create central Cloister
        Room cloister;
        cloister.type = RoomType::Cloister;
        cloister.width = 13;
        cloister.height = 11;
        cloister.x = (MAP_W - cloister.width) / 2;
        cloister.y = (MAP_H - cloister.height) / 2;
        rooms.push_back(cloister);

        // 2. Attach required rooms (Church, Chapter House, Refectory) around Cloister sides
        std::vector<RoomType> quadRooms = { RoomType::Church, RoomType::ChapterHouse, RoomType::Refectory };
        std::vector<int> sides = { 0, 1, 2, 3 }; // North, East, South, West
        std::shuffle(sides.begin(), sides.end(), rng);

        for (size_t i = 0; i < quadRooms.size(); ++i)
        {
            Room r;
            r.type = quadRooms[i];
            if (r.type == RoomType::Church) { r.width = 11; r.height = 7; }
            else if (r.type == RoomType::ChapterHouse) { r.width = 7; r.height = 6; }
            else if (r.type == RoomType::Refectory) { r.width = 9; r.height = 6; }

            AttachRoomToSide(r, cloister, sides[i]);
            rooms.push_back(r);
        }

        // 3. Generate peripheral rooms extending outward
        std::vector<RoomType> peripheralTypes = {
            RoomType::Gatehouse, RoomType::Library, RoomType::Scriptorium,
            RoomType::Cellar, RoomType::Pantry, RoomType::Kitchen,
            RoomType::Dormitory, RoomType::Calefactorium, RoomType::Infirmary,
            RoomType::Workshop, RoomType::Storage, RoomType::Garden, RoomType::Cemetery
        };
        std::shuffle(peripheralTypes.begin(), peripheralTypes.end(), rng);

        for (RoomType type : peripheralTypes)
        {
            Room room;
            room.type = type;
            room.width = RandomInt(5, 8);
            room.height = RandomInt(4, 7);

            if (type == RoomType::Garden || type == RoomType::Cemetery) {
                room.width = RandomInt(7, 10);
                room.height = RandomInt(6, 8);
            }

            bool placed = false;
            for (int attempt = 0; attempt < 300; ++attempt)
            {
                room.x = RandomInt(2, MAP_W - room.width - 3);
                room.y = RandomInt(2, MAP_H - room.height - 3);

                bool valid = true;
                for (const Room& existing : rooms)
                {
                    if (Overlaps(room, existing, 1))
                    {
                        valid = false;
                        break;
                    }
                }

                if (valid)
                {
                    rooms.push_back(room);
                    placed = true;
                    break;
                }
            }
        }

        FindSpecialRooms();
    }

    void AttachRoomToSide(Room& r, const Room& base, int side)
    {
        switch (side)
        {
            case 0: // North
                r.x = base.CenterX() - r.width / 2;
                r.y = base.y - r.height - 1;
                break;
            case 1: // East
                r.x = base.x + base.width + 1;
                r.y = base.CenterY() - r.height / 2;
                break;
            case 2: // South
                r.x = base.CenterX() - r.width / 2;
                r.y = base.y + base.height + 1;
                break;
            case 3: // West
                r.x = base.x - r.width - 1;
                r.y = base.CenterY() - r.height / 2;
                break;
        }
        r.x = std::clamp(r.x, 2, MAP_W - r.width - 3);
        r.y = std::clamp(r.y, 2, MAP_H - r.height - 3);
    }

    void FindSpecialRooms()
    {
        entranceRoom = -1;
        libraryRoom = -1;

        for (int i = 0; i < static_cast<int>(rooms.size()); ++i)
        {
            if (rooms[i].type == RoomType::Gatehouse) entranceRoom = i;
            if (rooms[i].type == RoomType::Library) libraryRoom = i;
        }
    }

    void CarveRoom(const Room& room)
    {
        Tile floorType = Tile::Floor;
        if (room.type == RoomType::Cloister) floorType = Tile::Courtyard;
        else if (room.type == RoomType::Garden || room.type == RoomType::Cemetery) floorType = Tile::Garden;
        else if (room.type == RoomType::Cellar || room.type == RoomType::Crypt) floorType = Tile::Cellar;

        for (int y = room.y; y < room.y + room.height; ++y)
        {
            for (int x = room.x; x < room.x + room.width; ++x)
            {
                if (x > 0 && y > 0 && x < MAP_W - 1 && y < MAP_H - 1)
                    tiles[y][x] = floorType;
            }
        }
    }

    void CarveCorridor(int x1, int y1, int x2, int y2)
    {
        int x = x1, y = y1;
        while (x != x2)
        {
            CarveTile(x, y);
            x += (x2 > x) ? 1 : -1;
        }
        while (y != y2)
        {
            CarveTile(x, y);
            y += (y2 > y) ? 1 : -1;
        }
        CarveTile(x2, y2);
    }

    void CarveTile(int x, int y)
    {
        if (x <= 0 || y <= 0 || x >= MAP_W - 1 || y >= MAP_H - 1) return;
        if (tiles[y][x] == Tile::Wall) tiles[y][x] = Tile::Floor;
    }

    void ConnectRooms()
    {
        if (rooms.empty()) return;

        std::vector<bool> connected(rooms.size(), false);
        connected[0] = true;
        int connectedCount = 1;

        while (connectedCount < static_cast<int>(rooms.size()))
        {
            int bestFrom = -1, bestTo = -1;
            int bestDistance = std::numeric_limits<int>::max();

            for (size_t i = 0; i < rooms.size(); ++i)
            {
                if (!connected[i]) continue;
                for (size_t j = 0; j < rooms.size(); ++j)
                {
                    if (connected[j]) continue;
                    int dist = std::abs(rooms[i].CenterX() - rooms[j].CenterX()) +
                               std::abs(rooms[i].CenterY() - rooms[j].CenterY());
                    if (dist < bestDistance)
                    {
                        bestDistance = dist;
                        bestFrom = i;
                        bestTo = j;
                    }
                }
            }

            if (bestFrom != -1 && bestTo != -1)
            {
                CarveCorridor(rooms[bestFrom].CenterX(), rooms[bestFrom].CenterY(),
                              rooms[bestTo].CenterX(), rooms[bestTo].CenterY());
                connected[bestTo] = true;
                connectedCount++;
            }
            else break;
        }
    }

    void AddArchitecture()
    {
        for (const Room& room : rooms) CarveRoom(room);
        AddCloisterDetails();
    }

    void AddCloisterDetails()
    {
        for (const Room& room : rooms)
        {
            if (room.type != RoomType::Cloister) continue;

            int innerX = room.x + 2;
            int innerY = room.y + 2;
            int innerW = room.width - 4;
            int innerH = room.height - 4;

            for (int y = innerY; y < innerY + innerH; ++y)
                for (int x = innerX; x < innerX + innerW; ++x)
                    tiles[y][x] = Tile::Garden;

            for (int x = room.x + 1; x < room.x + room.width - 1; ++x)
            {
                tiles[room.y + 1][x] = Tile::Floor;
                tiles[room.y + room.height - 2][x] = Tile::Floor;
            }
            for (int y = room.y + 1; y < room.y + room.height - 1; ++y)
            {
                tiles[y][room.x + 1] = Tile::Floor;
                tiles[y][room.x + room.width - 2] = Tile::Floor;
            }
        }
    }

    void AddEntrance()
    {
        if (entranceRoom < 0) return;
        const Room& gate = rooms[entranceRoom];
        tiles[gate.CenterY()][gate.x] = Tile::Door;
    }

    void AddCellarStairs()
    {
        for (const Room& room : rooms)
        {
            if (room.type == RoomType::Cellar)
            {
                tiles[room.CenterY()][room.CenterX()] = Tile::Stair;
                return;
            }
        }
    }

    void RestoreOuterWalls()
    {
        for (int x = 0; x < MAP_W; ++x) { tiles[0][x] = Tile::Wall; tiles[MAP_H - 1][x] = Tile::Wall; }
        for (int y = 0; y < MAP_H; ++y) { tiles[y][0] = Tile::Wall; tiles[y][MAP_W - 1] = Tile::Wall; }
    }

    bool IsWalkableTile(int x, int y) const
    {
        if (x < 0 || y < 0 || x >= MAP_W || y >= MAP_H) return false;
        return IsWalkable(tiles[y][x]);
    }

    int GetRoomAt(float worldX, float worldY) const
    {
        int tileX = static_cast<int>(worldX / TILE_SIZE);
        int tileY = static_cast<int>(worldY / TILE_SIZE);
        for (size_t i = 0; i < rooms.size(); ++i)
        {
            if (rooms[i].Contains(tileX, tileY)) return i;
        }
        return -1;
    }

    bool CircleCollides(sf::Vector2f position, float radius) const
    {
        int minX = std::max(0, static_cast<int>((position.x - radius) / TILE_SIZE));
        int maxX = std::min(MAP_W - 1, static_cast<int>((position.x + radius) / TILE_SIZE));
        int minY = std::max(0, static_cast<int>((position.y - radius) / TILE_SIZE));
        int maxY = std::min(MAP_H - 1, static_cast<int>((position.y + radius) / TILE_SIZE));

        for (int y = minY; y <= maxY; ++y)
        {
            for (int x = minX; x <= maxX; ++x)
            {
                if (IsWalkableTile(x, y)) continue;

                float left = static_cast<float>(x * TILE_SIZE);
                float top = static_cast<float>(y * TILE_SIZE);
                float closestX = std::clamp(position.x, left, left + TILE_SIZE);
                float closestY = std::clamp(position.y, top, top + TILE_SIZE);

                float dx = position.x - closestX;
                float dy = position.y - closestY;

                if (dx * dx + dy * dy < radius * radius) return true;
            }
        }
        return false;
    }
};

// ============================================================
// A* Pathfinding (Coordinates matrix fix: [y][x])
// ============================================================

struct Node
{
    int x, y;
    float g, f;
};

float Heuristic(int x1, int y1, int x2, int y2)
{
    return static_cast<float>(std::abs(x1 - x2) + std::abs(y1 - y2));
}

std::vector<sf::Vector2i> FindPath(const Abbey& abbey, sf::Vector2f start, sf::Vector2f goal)
{
    int startX = static_cast<int>(start.x / TILE_SIZE);
    int startY = static_cast<int>(start.y / TILE_SIZE);
    int goalX = static_cast<int>(goal.x / TILE_SIZE);
    int goalY = static_cast<int>(goal.y / TILE_SIZE);

    if (!abbey.IsWalkableTile(startX, startY) || !abbey.IsWalkableTile(goalX, goalY))
        return {};

    struct Parent { int x = -1, y = -1; };

    std::vector<std::vector<float>> gScore(MAP_H, std::vector<float>(MAP_W, std::numeric_limits<float>::infinity()));
    std::vector<std::vector<bool>> closed(MAP_H, std::vector<bool>(MAP_W, false));
    std::vector<std::vector<Parent>> parent(MAP_H, std::vector<Parent>(MAP_W));
    std::vector<Node> open;

    gScore[startY][startX] = 0.0f;
    open.push_back({ startX, startY, 0.0f, Heuristic(startX, startY, goalX, goalY) });

    constexpr int dirs[4][2] = { {1,0}, {-1,0}, {0,1}, {0,-1} };

    while (!open.empty())
    {
        int bestIdx = 0;
        for (size_t i = 1; i < open.size(); ++i)
        {
            if (open[i].f < open[bestIdx].f) bestIdx = i;
        }

        Node current = open[bestIdx];
        open.erase(open.begin() + bestIdx);

        if (closed[current.y][current.x]) continue;
        closed[current.y][current.x] = true;

        if (current.x == goalX && current.y == goalY)
        {
            std::vector<sf::Vector2i> path;
            int x = goalX, y = goalY;
            while (!(x == startX && y == startY))
            {
                path.emplace_back(x, y);
                Parent p = parent[y][x];
                if (p.x < 0 || p.y < 0) return {};
                x = p.x; y = p.y;
            }
            std::reverse(path.begin(), path.end());
            return path;
        }

        for (const auto& dir : dirs)
        {
            int nx = current.x + dir[0];
            int ny = current.y + dir[1];

            if (!abbey.IsWalkableTile(nx, ny) || closed[ny][nx]) continue;

            float tentativeG = gScore[current.y][current.x] + 1.0f;
            if (tentativeG < gScore[ny][nx])
            {
                gScore[ny][nx] = tentativeG;
                parent[ny][nx] = { current.x, current.y };
                open.push_back({ nx, ny, tentativeG, tentativeG + Heuristic(nx, ny, goalX, goalY) });
            }
        }
    }
    return {};
}

// ============================================================
// Enemy
// ============================================================

struct Enemy
{
    sf::Vector2f position;
    int roomIndex = -1;
    int hp = 30;
    float pathTimer = 0.0f;
    float attackTimer = 0.0f;
    std::vector<sf::Vector2i> path;
    int pathIndex = 0;
    bool alive = true;
};

// ============================================================
// Drawing Helpers
// ============================================================

void DrawCenteredText(sf::RenderWindow& window, sf::Font& font, const std::string& text, unsigned int size, float y)
{
    sf::Text label(font, text, size);
    sf::FloatRect bounds = label.getLocalBounds();
    label.setOrigin({ bounds.position.x + bounds.size.x / 2.0f, bounds.position.y + bounds.size.y / 2.0f });
    label.setPosition({ WINDOW_W / 2.0f, y });
    window.draw(label);
}

// ============================================================
// Main Application
// ============================================================

int main()
{
    sf::RenderWindow window(sf::VideoMode({ WINDOW_W, WINDOW_H }), "Procedural Abbey");
    window.setFramerateLimit(120);

    sf::Font font;
    if (!font.openFromFile("resources/DejaVuSansMono.ttf")) return 1;

    Abbey abbey;
    sf::Vector2f playerPosition;
    int playerRoom = -1;
    int playerHP = PLAYER_MAX_HP;
    bool gameWon = false, gameOver = false;

    std::vector<Enemy> enemies;

    auto SpawnGame = [&]()
    {
        abbey.Generate();
        playerHP = PLAYER_MAX_HP;
        gameWon = false;
        gameOver = false;
        enemies.clear();

        if (abbey.entranceRoom >= 0)
        {
            const Room& gate = abbey.rooms[abbey.entranceRoom];
            playerPosition = { (gate.CenterX() + 0.5f) * TILE_SIZE, (gate.CenterY() + 0.5f) * TILE_SIZE };
        }
        else
        {
            playerPosition = { TILE_SIZE * 2.5f, TILE_SIZE * 2.5f };
        }

        for (size_t i = 0; i < abbey.rooms.size(); ++i)
        {
            const Room& room = abbey.rooms[i];
            if (room.type == RoomType::Garden || room.type == RoomType::Cloister || room.type == RoomType::Gatehouse)
                continue;

            if (RandomInt(0, 100) > 60) continue;

            Enemy enemy;
            enemy.roomIndex = static_cast<int>(i);
            enemy.position = { (room.CenterX() + 0.5f) * TILE_SIZE, (room.CenterY() + 0.5f) * TILE_SIZE };
            enemy.hp = RandomInt(20, 40);
            enemies.push_back(enemy);
        }
    };

    SpawnGame();
    sf::Clock clock;

    while (window.isOpen())
    {
        float dt = std::min(clock.restart().asSeconds(), 0.05f);

        while (const std::optional event = window.pollEvent())
        {
            if (event->is<sf::Event::Closed>()) window.close();
            if (const auto* key = event->getIf<sf::Event::KeyPressed>())
            {
                if (key->scancode == sf::Keyboard::Scancode::R) SpawnGame();
            }
        }

        if (!gameWon && !gameOver)
        {
            // Player Movement
            sf::Vector2f direction;
            if (sf::Keyboard::isKeyPressed(sf::Keyboard::Scancode::W)) direction.y -= 1.0f;
            if (sf::Keyboard::isKeyPressed(sf::Keyboard::Scancode::S)) direction.y += 1.0f;
            if (sf::Keyboard::isKeyPressed(sf::Keyboard::Scancode::A)) direction.x -= 1.0f;
            if (sf::Keyboard::isKeyPressed(sf::Keyboard::Scancode::D)) direction.x += 1.0f;

            float length = std::sqrt(direction.x * direction.x + direction.y * direction.y);
            if (length > 0.0f) direction /= length;

            sf::Vector2f velocity = direction * PLAYER_SPEED * dt;

            // Collision X
            sf::Vector2f newX = { playerPosition.x + velocity.x, playerPosition.y };
            if (!abbey.CircleCollides(newX, PLAYER_RADIUS)) playerPosition.x = newX.x;

            // Collision Y (FIXED: Preserves playerPosition.x correctly)
            sf::Vector2f newY = { playerPosition.x, playerPosition.y + velocity.y };
            if (!abbey.CircleCollides(newY, PLAYER_RADIUS)) playerPosition.y = newY.y;

            playerRoom = abbey.GetRoomAt(playerPosition.x, playerPosition.y);

            // Win condition check
            if (abbey.libraryRoom >= 0)
            {
                const Room& lib = abbey.rooms[abbey.libraryRoom];
                float dist = std::hypot(playerPosition.x - (lib.CenterX() + 0.5f) * TILE_SIZE,
                                        playerPosition.y - (lib.CenterY() + 0.5f) * TILE_SIZE);
                if (dist < TILE_SIZE * 0.8f) gameWon = true;
            }

            // Enemy Logic
            for (Enemy& enemy : enemies)
            {
                if (!enemy.alive || enemy.roomIndex != playerRoom) continue;

                enemy.pathTimer -= dt;
                enemy.attackTimer -= dt;
                float dist = std::hypot(playerPosition.x - enemy.position.x, playerPosition.y - enemy.position.y);

                if (dist <= ATTACK_RANGE)
                {
                    if (enemy.attackTimer <= 0.0f)
                    {
                        playerHP -= ENEMY_DAMAGE;
                        enemy.attackTimer = ATTACK_COOLDOWN;
                        if (playerHP <= 0) { playerHP = 0; gameOver = true; }
                    }
                    continue;
                }

                if (enemy.pathTimer <= 0.0f)
                {
                    enemy.path = FindPath(abbey, enemy.position, playerPosition);
                    enemy.pathIndex = 0;
                    enemy.pathTimer = PATH_RECALC_TIME;
                }

                if (enemy.pathIndex < static_cast<int>(enemy.path.size()))
                {
                    sf::Vector2i targetTile = enemy.path[enemy.pathIndex];
                    sf::Vector2f target = { (targetTile.x + 0.5f) * TILE_SIZE, (targetTile.y + 0.5f) * TILE_SIZE };
                    sf::Vector2f move = target - enemy.position;
                    float moveLength = std::hypot(move.x, move.y);

                    if (moveLength < 2.0f) enemy.pathIndex++;
                    else
                    {
                        move /= moveLength;
                        sf::Vector2f candidate = enemy.position + move * ENEMY_SPEED * dt;
                        if (!abbey.CircleCollides(candidate, ENEMY_RADIUS)) enemy.position = candidate;
                    }
                }
            }
        }

        // Render
        window.clear(sf::Color(18, 18, 18));
        sf::RectangleShape tileShape(sf::Vector2f(TILE_SIZE - 1.0f, TILE_SIZE - 1.0f));

        for (int y = 0; y < MAP_H; ++y)
        {
            for (int x = 0; x < MAP_W; ++x)
            {
                switch (abbey.tiles[y][x])
                {
                    case Tile::Wall:      tileShape.setFillColor(sf::Color(55, 55, 55)); break;
                    case Tile::Floor:     tileShape.setFillColor(sf::Color(115, 105, 90)); break;
                    case Tile::Courtyard: tileShape.setFillColor(sf::Color(90, 115, 75)); break;
                    case Tile::Garden:    tileShape.setFillColor(sf::Color(65, 105, 65)); break;
                    case Tile::Cellar:    tileShape.setFillColor(sf::Color(75, 75, 85)); break;
                    case Tile::Door:      tileShape.setFillColor(sf::Color(150, 105, 55)); break;
                    case Tile::Stair:     tileShape.setFillColor(sf::Color(130, 100, 160)); break;
                }
                tileShape.setPosition({ static_cast<float>(x * TILE_SIZE), static_cast<float>(y * TILE_SIZE) });
                window.draw(tileShape);
            }
        }

        // Room Labels
        for (const Room& room : abbey.rooms)
        {
            sf::Text label(font, RoomTypeName(room.type), 8);
            sf::FloatRect bounds = label.getLocalBounds();
            label.setOrigin({ bounds.position.x + bounds.size.x / 2.0f, bounds.position.y + bounds.size.y / 2.0f });
            label.setPosition({ (room.CenterX() + 0.5f) * TILE_SIZE, (room.CenterY() + 0.5f) * TILE_SIZE });
            label.setFillColor(sf::Color(230, 220, 190));
            window.draw(label);
        }

        // Draw Player
        sf::CircleShape player(PLAYER_RADIUS);
        player.setOrigin({ PLAYER_RADIUS, PLAYER_RADIUS });
        player.setPosition(playerPosition);
        player.setFillColor(sf::Color(80, 170, 240));
        window.draw(player);

        // Draw Enemies
        for (const Enemy& enemy : enemies)
        {
            if (!enemy.alive || enemy.roomIndex != playerRoom) continue;
            sf::CircleShape monster(ENEMY_RADIUS);
            monster.setOrigin({ ENEMY_RADIUS, ENEMY_RADIUS });
            monster.setPosition(enemy.position);
            monster.setFillColor(sf::Color(190, 65, 65));
            window.draw(monster);
        }

        // Overlay & Text
        sf::Text hpText(font, "HP: " + std::to_string(playerHP), 14);
        hpText.setPosition({ 8.0f, 5.0f });
        hpText.setFillColor(sf::Color::White);
        window.draw(hpText);

        if (gameWon)
        {
            DrawCenteredText(window, font, "YOU REACHED THE LIBRARY!", 28, WINDOW_H / 2.0f - 20.0f);
            DrawCenteredText(window, font, "PRESS R TO RESTART", 16, WINDOW_H / 2.0f + 20.0f);
        }
        else if (gameOver)
        {
            DrawCenteredText(window, font, "YOU DIED", 32, WINDOW_H / 2.0f - 20.0f);
            DrawCenteredText(window, font, "PRESS R TO RESTART", 16, WINDOW_H / 2.0f + 20.0f);
        }

        window.display();
    }

    return 0;
}
