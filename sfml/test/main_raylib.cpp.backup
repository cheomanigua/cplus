#include "raylib.h"

#include <algorithm>
#include <array>
#include <cmath>
#include <limits>
#include <random>
#include <string>
#include <vector>

// ============================================================
// Configuration
// ============================================================

constexpr int TileSize = 24;

constexpr int MapWidth = 50;
constexpr int MapHeight = 32;

constexpr int WindowWidth = MapWidth * TileSize;
constexpr int WindowHeight = MapHeight * TileSize;

constexpr float PlayerRadius = 8.0f;
constexpr float PlayerSpeed = 150.0f;

constexpr int MaxRooms = 12;
constexpr int MinRoomSize = 5;
constexpr int MaxRoomSize = 10;

constexpr int EnemyCount = 12;

constexpr float EnemyRadius = 7.0f;
constexpr float EnemySpeed = 65.0f;

constexpr float PathUpdateTime = 0.25f;

constexpr float PlayerMaxHealth = 100.0f;

constexpr float EnemyAttackDistance = 16.0f;
constexpr float EnemyAttackCooldown = 0.8f;
constexpr float EnemyDamage = 10.0f;


// ============================================================
// Tile
// ============================================================

enum class Tile
{
    Wall,
    Floor
};


// ============================================================
// Room
// ============================================================

struct Room
{
    int x;
    int y;
    int width;
    int height;

    int CenterX() const
    {
        return x + width / 2;
    }

    int CenterY() const
    {
        return y + height / 2;
    }

    bool Contains(int tileX, int tileY) const
    {
        return
            tileX >= x &&
            tileX < x + width &&
            tileY >= y &&
            tileY < y + height;
    }
};


// ============================================================
// Enemy
// ============================================================

struct Enemy
{
    Vector2 position{};

    float radius = EnemyRadius;

    // Room this enemy belongs to.
    int roomIndex = -1;

    // A* path.
    std::vector<Vector2> path;

    size_t pathIndex = 0;

    float pathTimer = 0.0f;

    // Attack cooldown.
    float attackTimer = 0.0f;
};


// ============================================================
// Dungeon
// ============================================================

class Dungeon
{
public:

    Dungeon()
        : randomEngine(randomDevice())
    {
        Generate();
    }

    void Generate()
    {
        tiles.assign(
            MapWidth * MapHeight,
            Tile::Wall);

        rooms.clear();

        GenerateRooms();
        ConnectRooms();
    }

    Tile GetTile(int x, int y) const
    {
        if (x < 0 ||
            x >= MapWidth ||
            y < 0 ||
            y >= MapHeight)
        {
            return Tile::Wall;
        }

        return tiles[y * MapWidth + x];
    }

    bool IsWalkable(int x, int y) const
    {
        return GetTile(x, y) == Tile::Floor;
    }

    const std::vector<Room>& GetRooms() const
    {
        return rooms;
    }

    Vector2 GetRoomCenter(int index) const
    {
        const Room& room = rooms[index];

        return {
            (room.CenterX() + 0.5f) * TileSize,
            (room.CenterY() + 0.5f) * TileSize
        };
    }

    int GetRoomAtTile(int tileX, int tileY) const
    {
        for (int i = 0;
             i < static_cast<int>(rooms.size());
             ++i)
        {
            if (rooms[i].Contains(tileX, tileY))
                return i;
        }

        return -1;
    }

private:

    std::vector<Tile> tiles;
    std::vector<Room> rooms;

    std::random_device randomDevice;
    std::mt19937 randomEngine;

    void Carve(int x, int y)
    {
        if (x < 0 ||
            x >= MapWidth ||
            y < 0 ||
            y >= MapHeight)
        {
            return;
        }

        tiles[y * MapWidth + x] = Tile::Floor;
    }

    bool RoomOverlaps(
        const Room& a,
        const Room& b) const
    {
        constexpr int padding = 1;

        return
            a.x - padding < b.x + b.width &&
            a.x + a.width + padding > b.x &&
            a.y - padding < b.y + b.height &&
            a.y + a.height + padding > b.y;
    }

    void CarveRoom(const Room& room)
    {
        for (int y = room.y;
             y < room.y + room.height;
             ++y)
        {
            for (int x = room.x;
                 x < room.x + room.width;
                 ++x)
            {
                Carve(x, y);
            }
        }
    }

    void CarveHorizontal(
        int x1,
        int x2,
        int y)
    {
        const int start = std::min(x1, x2);
        const int end = std::max(x1, x2);

        for (int x = start;
             x <= end;
             ++x)
        {
            Carve(x, y);
        }
    }

    void CarveVertical(
        int y1,
        int y2,
        int x)
    {
        const int start = std::min(y1, y2);
        const int end = std::max(y1, y2);

        for (int y = start;
             y <= end;
             ++y)
        {
            Carve(x, y);
        }
    }

    void ConnectRooms()
    {
        if (rooms.size() < 2)
            return;

        for (size_t i = 1;
             i < rooms.size();
             ++i)
        {
            const Room& previous =
                rooms[i - 1];

            const Room& current =
                rooms[i];

            const int x1 =
                previous.CenterX();

            const int y1 =
                previous.CenterY();

            const int x2 =
                current.CenterX();

            const int y2 =
                current.CenterY();

            std::uniform_int_distribution<int>
                coin(0, 1);

            if (coin(randomEngine) == 0)
            {
                CarveHorizontal(x1, x2, y1);
                CarveVertical(y1, y2, x2);
            }
            else
            {
                CarveVertical(y1, y2, x1);
                CarveHorizontal(x1, x2, y2);
            }
        }
    }

    void GenerateRooms()
    {
        std::uniform_int_distribution<int>
            roomWidth(
                MinRoomSize,
                MaxRoomSize);

        std::uniform_int_distribution<int>
            roomHeight(
                MinRoomSize,
                MaxRoomSize);

        std::uniform_int_distribution<int>
            roomX(
                1,
                MapWidth -
                    MaxRoomSize -
                    2);

        std::uniform_int_distribution<int>
            roomY(
                1,
                MapHeight -
                    MaxRoomSize -
                    2);

        for (int attempt = 0;
             attempt < 1000 &&
             static_cast<int>(rooms.size()) <
                 MaxRooms;
             ++attempt)
        {
            Room newRoom{
                roomX(randomEngine),
                roomY(randomEngine),
                roomWidth(randomEngine),
                roomHeight(randomEngine)
            };

            bool overlaps = false;

            for (const Room& room : rooms)
            {
                if (RoomOverlaps(
                        newRoom,
                        room))
                {
                    overlaps = true;
                    break;
                }
            }

            if (overlaps)
                continue;

            CarveRoom(newRoom);

            rooms.push_back(newRoom);
        }
    }
};


// ============================================================
// Utility
// ============================================================

Vector2 WorldToTile(Vector2 position)
{
    return {
        std::floor(position.x / TileSize),
        std::floor(position.y / TileSize)
    };
}


Vector2 TileToWorld(Vector2 tile)
{
    return {
        (tile.x + 0.5f) * TileSize,
        (tile.y + 0.5f) * TileSize
    };
}


// ============================================================
// Player / Enemy collision with dungeon
// ============================================================

bool CircleCollidesWithDungeon(
    Vector2 position,
    float radius,
    const Dungeon& dungeon)
{
    const int minX =
        static_cast<int>(
            (position.x - radius) /
            TileSize) - 1;

    const int maxX =
        static_cast<int>(
            (position.x + radius) /
            TileSize) + 1;

    const int minY =
        static_cast<int>(
            (position.y - radius) /
            TileSize) - 1;

    const int maxY =
        static_cast<int>(
            (position.y + radius) /
            TileSize) + 1;

    for (int y = minY;
         y <= maxY;
         ++y)
    {
        for (int x = minX;
             x <= maxX;
             ++x)
        {
            if (dungeon.IsWalkable(x, y))
                continue;

            const float wallLeft =
                static_cast<float>(
                    x * TileSize);

            const float wallTop =
                static_cast<float>(
                    y * TileSize);

            const float wallRight =
                wallLeft + TileSize;

            const float wallBottom =
                wallTop + TileSize;

            const float closestX =
                std::clamp(
                    position.x,
                    wallLeft,
                    wallRight);

            const float closestY =
                std::clamp(
                    position.y,
                    wallTop,
                    wallBottom);

            const float dx =
                position.x - closestX;

            const float dy =
                position.y - closestY;

            if (dx * dx + dy * dy <
                radius * radius)
            {
                return true;
            }
        }
    }

    return false;
}


// ============================================================
// Player movement
// ============================================================

void MovePlayer(
    Vector2& playerPosition,
    const Dungeon& dungeon,
    Vector2 movement)
{
    playerPosition.x += movement.x;

    if (CircleCollidesWithDungeon(
            playerPosition,
            PlayerRadius,
            dungeon))
    {
        playerPosition.x -= movement.x;
    }

    playerPosition.y += movement.y;

    if (CircleCollidesWithDungeon(
            playerPosition,
            PlayerRadius,
            dungeon))
    {
        playerPosition.y -= movement.y;
    }
}


// ============================================================
// A* pathfinding
// ============================================================

int ManhattanDistance(
    Vector2 a,
    Vector2 b)
{
    return
        static_cast<int>(
            std::abs(a.x - b.x) +
            std::abs(a.y - b.y));
}


std::vector<Vector2> FindPath(
    const Dungeon& dungeon,
    Vector2 start,
    Vector2 goal)
{
    const int startX =
        static_cast<int>(start.x);

    const int startY =
        static_cast<int>(start.y);

    const int goalX =
        static_cast<int>(goal.x);

    const int goalY =
        static_cast<int>(goal.y);

    if (!dungeon.IsWalkable(
            startX,
            startY))
    {
        return {};
    }

    if (!dungeon.IsWalkable(
            goalX,
            goalY))
    {
        return {};
    }

    if (startX == goalX &&
        startY == goalY)
    {
        return {};
    }

    const int totalTiles =
        MapWidth * MapHeight;

    std::vector<int> gCosts(
        totalTiles,
        std::numeric_limits<int>::max());

    std::vector<int> parent(
        totalTiles,
        -1);

    std::vector<bool> closed(
        totalTiles,
        false);

    auto Index = [](int x, int y)
    {
        return y * MapWidth + x;
    };

    std::vector<Vector2> open;

    gCosts[Index(
        startX,
        startY)] = 0;

    open.push_back({
        static_cast<float>(startX),
        static_cast<float>(startY)
    });

    const std::array<Vector2, 4>
        directions{
            Vector2{1, 0},
            Vector2{-1, 0},
            Vector2{0, 1},
            Vector2{0, -1}
        };

    while (!open.empty())
    {
        int bestIndex = 0;

        for (int i = 1;
             i < static_cast<int>(open.size());
             ++i)
        {
            const int candidateX =
                static_cast<int>(
                    open[i].x);

            const int candidateY =
                static_cast<int>(
                    open[i].y);

            const int bestX =
                static_cast<int>(
                    open[bestIndex].x);

            const int bestY =
                static_cast<int>(
                    open[bestIndex].y);

            const int candidateF =
                gCosts[Index(
                    candidateX,
                    candidateY)] +
                ManhattanDistance(
                    open[i],
                    {static_cast<float>(goalX),
                     static_cast<float>(goalY)});

            const int bestF =
                gCosts[Index(
                    bestX,
                    bestY)] +
                ManhattanDistance(
                    open[bestIndex],
                    {static_cast<float>(goalX),
                     static_cast<float>(goalY)});

            if (candidateF < bestF)
                bestIndex = i;
        }

        const Vector2 current =
            open[bestIndex];

        open.erase(
            open.begin() + bestIndex);

        const int currentX =
            static_cast<int>(
                current.x);

        const int currentY =
            static_cast<int>(
                current.y);

        const int currentIndex =
            Index(currentX, currentY);

        if (closed[currentIndex])
            continue;

        closed[currentIndex] = true;

        if (currentX == goalX &&
            currentY == goalY)
        {
            std::vector<Vector2> path;

            int nodeIndex = currentIndex;

            while (nodeIndex !=
                   Index(startX, startY))
            {
                const int nodeX =
                    nodeIndex % MapWidth;

                const int nodeY =
                    nodeIndex / MapWidth;

                path.push_back({
                    static_cast<float>(nodeX),
                    static_cast<float>(nodeY)
                });

                nodeIndex =
                    parent[nodeIndex];

                if (nodeIndex < 0)
                    return {};
            }

            std::reverse(
                path.begin(),
                path.end());

            return path;
        }

        for (const Vector2& direction :
             directions)
        {
            const int nextX =
                currentX +
                static_cast<int>(
                    direction.x);

            const int nextY =
                currentY +
                static_cast<int>(
                    direction.y);

            if (nextX < 0 ||
                nextX >= MapWidth ||
                nextY < 0 ||
                nextY >= MapHeight)
            {
                continue;
            }

            if (!dungeon.IsWalkable(
                    nextX,
                    nextY))
            {
                continue;
            }

            const int nextIndex =
                Index(nextX, nextY);

            if (closed[nextIndex])
                continue;

            const int newGCost =
                gCosts[currentIndex] + 1;

            if (newGCost <
                gCosts[nextIndex])
            {
                gCosts[nextIndex] =
                    newGCost;

                parent[nextIndex] =
                    currentIndex;

                open.push_back({
                    static_cast<float>(nextX),
                    static_cast<float>(nextY)
                });
            }
        }
    }

    return {};
}


// ============================================================
// Enemy spawning
// ============================================================

std::vector<Enemy> CreateEnemies(
    const Dungeon& dungeon,
    std::mt19937& randomEngine)
{
    std::vector<Enemy> enemies;

    if (dungeon.GetRooms().size() < 2)
        return enemies;

    std::uniform_int_distribution<int>
        roomDistribution(
            1,
            static_cast<int>(
                dungeon.GetRooms().size()) - 1);

    for (int i = 0;
         i < EnemyCount;
         ++i)
    {
        const int roomIndex =
            roomDistribution(randomEngine);

        const Room& room =
            dungeon.GetRooms()[roomIndex];

        std::uniform_int_distribution<int>
            xDistribution(
                room.x + 1,
                room.x + room.width - 2);

        std::uniform_int_distribution<int>
            yDistribution(
                room.y + 1,
                room.y + room.height - 2);

        Enemy enemy;

        enemy.roomIndex =
            roomIndex;

        enemy.position = {
            (xDistribution(randomEngine) + 0.5f)
                * TileSize,

            (yDistribution(randomEngine) + 0.5f)
                * TileSize
        };

        enemies.push_back(enemy);
    }

    return enemies;
}


// ============================================================
// Enemy AI
// ============================================================

void UpdateEnemies(
    std::vector<Enemy>& enemies,
    const Dungeon& dungeon,
    Vector2 playerPosition,
    float dt,
    float& playerHealth)
{
    const Vector2 playerTile =
        WorldToTile(playerPosition);

    const int playerRoom =
        dungeon.GetRoomAtTile(
            static_cast<int>(playerTile.x),
            static_cast<int>(playerTile.y));

    for (Enemy& enemy : enemies)
    {
        // ----------------------------------------------------
        // Enemy only wakes up in its own room.
        // ----------------------------------------------------

        const bool active =
            enemy.roomIndex == playerRoom;

        if (!active)
        {
            enemy.path.clear();
            enemy.pathIndex = 0;
            enemy.pathTimer = 0.0f;

            continue;
        }


        // ----------------------------------------------------
        // Attack timer
        // ----------------------------------------------------

        if (enemy.attackTimer > 0.0f)
            enemy.attackTimer -= dt;


        // ----------------------------------------------------
        // Distance to player
        // ----------------------------------------------------

        const float dx =
            playerPosition.x -
            enemy.position.x;

        const float dy =
            playerPosition.y -
            enemy.position.y;

        const float distance =
            std::sqrt(
                dx * dx +
                dy * dy);


        // ----------------------------------------------------
        // Attack
        // ----------------------------------------------------

        if (distance <= EnemyAttackDistance)
        {
            if (enemy.attackTimer <= 0.0f)
            {
                playerHealth -=
                    EnemyDamage;

                enemy.attackTimer =
                    EnemyAttackCooldown;
            }

            continue;
        }


        // ----------------------------------------------------
        // Recalculate path
        // ----------------------------------------------------

        enemy.pathTimer -= dt;

        if (enemy.pathTimer <= 0.0f)
        {
            enemy.pathTimer =
                PathUpdateTime;

            const Vector2 enemyTile =
                WorldToTile(
                    enemy.position);

            enemy.path =
                FindPath(
                    dungeon,
                    enemyTile,
                    playerTile);

            enemy.pathIndex = 0;
        }


        // ----------------------------------------------------
        // Follow path
        // ----------------------------------------------------

        if (enemy.path.empty())
            continue;

        if (enemy.pathIndex >=
            enemy.path.size())
        {
            continue;
        }

        const Vector2 target =
            TileToWorld(
                enemy.path[
                    enemy.pathIndex]);

        float moveX =
            target.x -
            enemy.position.x;

        float moveY =
            target.y -
            enemy.position.y;

        const float targetDistance =
            std::sqrt(
                moveX * moveX +
                moveY * moveY);

        if (targetDistance < 2.0f)
        {
            ++enemy.pathIndex;
            continue;
        }

        moveX /=
            targetDistance;

        moveY /=
            targetDistance;

        Vector2 movement{
            moveX * EnemySpeed * dt,
            moveY * EnemySpeed * dt
        };


        // ----------------------------------------------------
        // X collision
        // ----------------------------------------------------

        enemy.position.x +=
            movement.x;

        if (CircleCollidesWithDungeon(
                enemy.position,
                enemy.radius,
                dungeon))
        {
            enemy.position.x -=
                movement.x;
        }


        // ----------------------------------------------------
        // Y collision
        // ----------------------------------------------------

        enemy.position.y +=
            movement.y;

        if (CircleCollidesWithDungeon(
                enemy.position,
                enemy.radius,
                dungeon))
        {
            enemy.position.y -=
                movement.y;
        }
    }

    playerHealth =
        std::max(
            0.0f,
            playerHealth);
}


// ============================================================
// Drawing
// ============================================================

void DrawDungeon(
    const Dungeon& dungeon)
{
    for (int y = 0;
         y < MapHeight;
         ++y)
    {
        for (int x = 0;
             x < MapWidth;
             ++x)
        {
            Color color;

            if (dungeon.IsWalkable(
                    x,
                    y))
            {
                color = Color{
                    45,
                    45,
                    52,
                    255
                };
            }
            else
            {
                color = Color{
                    18,
                    18,
                    22,
                    255
                };
            }

            DrawRectangle(
                x * TileSize,
                y * TileSize,
                TileSize - 1,
                TileSize - 1,
                color);
        }
    }
}


// ============================================================
// Main
// ============================================================

int main()
{
    InitWindow(
        WindowWidth,
        WindowHeight,
        "raylib - Roguelike");

    SetTargetFPS(120);


    // ========================================================
    // Random generator
    // ========================================================

    std::random_device randomDevice;

    std::mt19937 randomEngine(
        randomDevice());


    // ========================================================
    // Dungeon
    // ========================================================

    Dungeon dungeon;


    // ========================================================
    // Player
    // ========================================================

    Vector2 playerPosition =
        dungeon.GetRoomCenter(0);

    float playerHealth =
        PlayerMaxHealth;


    // ========================================================
    // Exit
    // ========================================================

    Vector2 exitPosition =
        dungeon.GetRoomCenter(
            static_cast<int>(
                dungeon.GetRooms().size()) - 1);


    // ========================================================
    // Enemies
    // ========================================================

    std::vector<Enemy> enemies =
        CreateEnemies(
            dungeon,
            randomEngine);


    // ========================================================
    // Game state
    // ========================================================

    bool gameWon = false;
    bool gameOver = false;


    // ========================================================
    // Main loop
    // ========================================================

    while (!WindowShouldClose())
    {
        const float dt =
            std::min(
                GetFrameTime(),
                0.05f);


        // ====================================================
        // New dungeon
        // ====================================================

        if (IsKeyPressed(KEY_R))
        {
            dungeon.Generate();

            playerPosition =
                dungeon.GetRoomCenter(0);

            exitPosition =
                dungeon.GetRoomCenter(
                    static_cast<int>(
                        dungeon.GetRooms().size()) - 1);

            enemies =
                CreateEnemies(
                    dungeon,
                    randomEngine);

            playerHealth =
                PlayerMaxHealth;

            gameWon = false;
            gameOver = false;
        }


        // ====================================================
        // Gameplay
        // ====================================================

        if (!gameWon && !gameOver)
        {
            // ------------------------------------------------
            // Player movement
            // ------------------------------------------------

            Vector2 movement{
                0.0f,
                0.0f
            };

            if (IsKeyDown(KEY_W))
                movement.y -= 1.0f;

            if (IsKeyDown(KEY_S))
                movement.y += 1.0f;

            if (IsKeyDown(KEY_A))
                movement.x -= 1.0f;

            if (IsKeyDown(KEY_D))
                movement.x += 1.0f;


            const float length =
                std::sqrt(
                    movement.x * movement.x +
                    movement.y * movement.y);

            if (length > 0.0f)
            {
                movement.x /= length;
                movement.y /= length;

                movement.x *=
                    PlayerSpeed * dt;

                movement.y *=
                    PlayerSpeed * dt;

                MovePlayer(
                    playerPosition,
                    dungeon,
                    movement);
            }


            // ------------------------------------------------
            // Enemy AI
            // ------------------------------------------------

            UpdateEnemies(
                enemies,
                dungeon,
                playerPosition,
                dt,
                playerHealth);


            // ------------------------------------------------
            // Player death
            // ------------------------------------------------

            if (playerHealth <= 0.0f)
            {
                playerHealth = 0.0f;
                gameOver = true;
            }


            // ------------------------------------------------
            // Exit
            // ------------------------------------------------

            const float dx =
                playerPosition.x -
                exitPosition.x;

            const float dy =
                playerPosition.y -
                exitPosition.y;

            const float distanceSquared =
                dx * dx +
                dy * dy;

            if (distanceSquared <
                16.0f * 16.0f)
            {
                gameWon = true;
            }
        }


        // ====================================================
        // Active enemy count
        // ====================================================

        const Vector2 playerTile =
            WorldToTile(
                playerPosition);

        const int playerRoom =
            dungeon.GetRoomAtTile(
                static_cast<int>(
                    playerTile.x),
                static_cast<int>(
                    playerTile.y));

        int activeEnemies = 0;

        for (const Enemy& enemy : enemies)
        {
            if (enemy.roomIndex ==
                playerRoom)
            {
                ++activeEnemies;
            }
        }


        // ====================================================
        // Window title
        // ====================================================

        std::string title;

        if (gameWon)
        {
            title =
                "YOU ESCAPED! | "
                "HP: " +
                std::to_string(
                    static_cast<int>(
                        playerHealth)) +
                " | Press R";
        }
        else if (gameOver)
        {
            title =
                "YOU DIED! | Press R";
        }
        else
        {
            title =
                "Roguelike | HP: " +
                std::to_string(
                    static_cast<int>(
                        playerHealth)) +
                " | Active enemies: " +
                std::to_string(
                    activeEnemies) +
                " | WASD = Move | R = New Dungeon";
        }

        SetWindowTitle(
            title.c_str());


        // ====================================================
        // Rendering
        // ====================================================

        BeginDrawing();

        ClearBackground(
            Color{
                12,
                12,
                16,
                255
            });


        // ----------------------------------------------------
        // Dungeon
        // ----------------------------------------------------

        DrawDungeon(dungeon);


        // ----------------------------------------------------
        // Exit
        // ----------------------------------------------------

        if (!gameWon)
        {
            DrawRectangle(
                static_cast<int>(
                    exitPosition.x - 7),
                static_cast<int>(
                    exitPosition.y - 7),
                14,
                14,
                Color{
                    80,
                    220,
                    100,
                    255
                });
        }


        // ----------------------------------------------------
        // Enemies
        // ----------------------------------------------------

        for (const Enemy& enemy : enemies)
        {
            if (enemy.roomIndex ==
                playerRoom)
            {
                DrawCircleV(
                    enemy.position,
                    enemy.radius,
                    Color{
                        230,
                        60,
                        60,
                        255
                    });
            }
            else
            {
                DrawCircleV(
                    enemy.position,
                    enemy.radius,
                    Color{
                        100,
                        45,
                        45,
                        255
                    });
            }
        }


        // ----------------------------------------------------
        // Player
        // ----------------------------------------------------

        Color playerColor;

        if (gameOver)
        {
            playerColor = Color{
                100,
                100,
                100,
                255
            };
        }
        else if (gameWon)
        {
            playerColor = Color{
                100,
                255,
                120,
                255
            };
        }
        else
        {
            playerColor = Color{
                80,
                180,
                255,
                255
            };
        }

        DrawCircleV(
            playerPosition,
            PlayerRadius,
            playerColor);


        // ----------------------------------------------------
        // HP bar
        // ----------------------------------------------------

        if (!gameWon && !gameOver)
        {
            constexpr int barWidth = 160;
            constexpr int barHeight = 12;

            const float healthPercent =
                playerHealth /
                PlayerMaxHealth;

            DrawRectangle(
                10,
                10,
                barWidth,
                barHeight,
                Color{
                    40,
                    40,
                    40,
                    255
                });

            DrawRectangle(
                10,
                10,
                static_cast<int>(
                    barWidth *
                    healthPercent),
                barHeight,
                Color{
                    220,
                    60,
                    60,
                    255
                });
        }


        // ----------------------------------------------------
        // Game over / win text
        // ----------------------------------------------------

        if (gameWon)
        {
            DrawText(
                "YOU ESCAPED!",
                WindowWidth / 2 - 110,
                WindowHeight / 2 - 20,
                30,
                Color{
                    100,
                    255,
                    120,
                    255
                });

            DrawText(
                "Press R for a new dungeon",
                WindowWidth / 2 - 125,
                WindowHeight / 2 + 20,
                20,
                RAYWHITE);
        }

        if (gameOver)
        {
            DrawText(
                "YOU DIED!",
                WindowWidth / 2 - 80,
                WindowHeight / 2 - 20,
                30,
                Color{
                    230,
                    60,
                    60,
                    255
                });

            DrawText(
                "Press R for a new dungeon",
                WindowWidth / 2 - 125,
                WindowHeight / 2 + 20,
                20,
                RAYWHITE);
        }


        EndDrawing();
    }

    CloseWindow();

    return 0;
}
